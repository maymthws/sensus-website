# YouTube Data API v3 key — server-side only (used by Project Spotlight feed)
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# SENSUS YouTube channel ID (already known, override only if needed)
YOUTUBE_CHANNEL_ID=UCXtjwuX39ewNlcVwtKMP8zA

# Public site URL (used for SEO / OG tags)
NEXT_PUBLIC_SITE_URL=https://sensus.website

# Contact form delivery endpoint (Formspree / Resend / custom webhook)
# Leave empty to render the form in demo mode.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public social links (already wired, override only if rebranded)
NEXT_PUBLIC_X_URL=https://x.com/SensusHQ
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@SENSUSHQ
